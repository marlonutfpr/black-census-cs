analysis/data/*
!analysis/data/mapa_curso_nome.csv
!analysis/data/checksums_sha256.txt
!analysis/data/rq1_valores_lidos_fig4.csv
analysis/output/*
!analysis/output/*.csv
!analysis/output/*.txt
analysis/figures/

